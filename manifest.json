{
  "manifest_version": 3,
  "name": "Spam Detective",
  "version": "1.0",
  "permissions": ["activeTab","scripting"],
  "host_permissions": ["https://mail.google.com/*","http://localhost:5000/*"],
  "content_scripts": [
    {
      "matches":["https://mail.google.com/*"],
      "js": ["content.js"]
    }
  ]
    
}
